<?xml version="1.0"?>
<robot name="reacher">
    <!-- Base (неподвижная база на столе) -->
    <link name="base_link">
        <inertial>
            <mass value="2.0"/>
            <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
        </inertial>
        <visual>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
            <origin xyz="0 0 -0.025"/>
            <material name="base_material">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
            <origin xyz="0 0 -0.025"/>
        </collision>
    </link>

    <!-- Первый сегмент руки -->
    <link name="link1">
        <inertial>
            <mass value="1.0"/>
            <origin xyz="0.25 0 0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.001"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder length="0.5" radius="0.03"/>
            </geometry>
            <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
            <material name="link1_material">
                <color rgba="0.2 0.2 0.8 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.5" radius="0.03"/>
            </geometry>
            <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
        </collision>
    </link>

    <!-- Второй сегмент руки -->
    <link name="link2">
        <inertial>
            <mass value="1.0"/>
            <origin xyz="0.25 0 0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.001"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder length="0.5" radius="0.03"/>
            </geometry>
            <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
            <material name="link2_material">
                <color rgba="0.8 0.2 0.2 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.5" radius="0.03"/>
            </geometry>
            <origin xyz="0.25 0 0" rpy="0 1.5708 0"/>
        </collision>
    </link>

    <!-- Схват (конец руки) -->
    <link name="end_effector">
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
        <visual>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <material name="gripper_material">
                <color rgba="1.0 1.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </collision>
    </link>

    <!-- Первый сустав (база -> link1) - вращение вокруг оси Y -->
    <joint name="joint1" type="revolute">
        <parent link="base_link"/>
        <child link="link1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="20.0" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- Второй сустав (link1 -> link2) - вращение вокруг оси Z -->
    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="0.5 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14159" upper="3.14159" effort="20.0" velocity="2.0"/>
        <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <!-- Третий сустав (link2 -> end_effector) - фиксированный -->
    <joint name="joint3" type="fixed">
        <parent link="link2"/>
        <child link="end_effector"/>
        <origin xyz="0.5 0 0" rpy="0 0 0"/>
    </joint>
</robot>
